# Primjer lokalne konfiguracije. Kopirati u .env.local i popuniti vrijednostima
# ISKLJUČIVO iz zasebnog testnog Supabase projekta.
# Ovo su javne klijentske vrijednosti, nikad service_role ili secret key.
VITE_SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_TEST_PUBLISHABLE_KEY
